# Optional environment for the `python -m ming` development CLI.
# Browser/desktop API settings are configured in the game's Settings menu;
# they do not read these values. Claude CLI uses its own local login.
# Copy to .env and source it, or let ./start.sh source it.
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

# Pass the model explicitly with --scene-model / --model / --translation-model,
# e.g. openai-chat:<model-id>. No environment model override is used.

# Optional: desktop webview developer tools.
# MING_DEBUG=1
