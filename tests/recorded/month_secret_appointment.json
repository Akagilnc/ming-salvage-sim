{"facts":[{"entity_type":"incumbency","entity":"陕西巡抚","create":false,"decree":0,"changes":[{"field":"holders","value":["洪承畴"]}],"text":""},{"entity_type":"incumbency","entity":"陕西布政司右参政","create":false,"decree":0,"changes":[{"field":"holders","value":[]}],"text":"洪承畴升任陕西巡抚，离陕西布政司右参政原任。"},{"entity_type":"person","entity":"毕自严","create":false,"decree":0,"changes":[{"field":"location","value":"北直隶 / 京师"},{"field":"travel_speed","value":"常速"},{"field":"departure_day","value":5},{"field":"status","value":"active"}],"text":"毕自严接南京户部尚书旨后办完交代，乘驿启程赴京陛见，月底仍在途中，尚未入京；随行有暗护之人，路上无文字外泄。"},{"entity_type":"person","entity":"徐光启","create":false,"decree":0,"changes":[{"field":"status","value":"active"},{"field":"location","value":"北直隶 / 京师"},{"field":"travel_speed","value":"加急"},{"field":"departure_day","value":5}],"text":"徐光启奉旨起复礼部右侍郎，旨意到时已是月中，月内料理行装交代家务后启程赴京，月底仍在途中；朝中少有反应，礼部与言官间略有议论西学之语，未正式上本攻讦。"},{"entity_type":"incumbency","entity":"礼部右侍郎","create":false,"decree":0,"changes":[{"field":"holders","value":["徐光启"]}],"text":"徐光启奉旨起复，任礼部右侍郎。"},{"entity_type":"person","entity":"韩爌","create":false,"decree":0,"discovered":true,"changes":[{"field":"intrigue","value":75}],"text":""}],"reports":[],"decree_events":[]}