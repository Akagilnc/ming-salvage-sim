#!/usr/bin/env python3
import argparse
import json
import os
import re
import sys
from collections.abc import Iterator


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Validate a worker outcome draft before emitting completion output.",
    )
    parser.add_argument("--role", required=True)
    parser.add_argument("--draft", required=True)
    parser.add_argument("--outcome", required=True)
    parser.add_argument("--evidence-root", required=True)
    parser.add_argument("--completion-signal", required=True)
    args = parser.parse_args()

    try:
        with open(args.draft, encoding="utf-8") as f:
            draft = json.load(f)
        validate_outcome(args.role, draft, args.evidence_root)
        rendered = json.dumps(draft, separators=(",", ":"))
        with open(args.outcome, "w", encoding="utf-8") as f:
            f.write(rendered + "\n")
        tag = "cmr" if args.role == "cmr" else args.role
        sys.stdout.write(f"<{tag}>{rendered}</{tag}>\n{args.completion_signal}\n")
        return 0
    except GuardError as err:
        sys.stderr.write(f"outcome guard rejected {args.role} draft: {err}\n")
        return 1
    except (OSError, json.JSONDecodeError) as err:
        sys.stderr.write(f"outcome guard rejected {args.role} draft: {err}\n")
        return 1


class GuardError(Exception):
    pass


def validate_outcome(role: str, draft: object, evidence_root: str) -> None:
    if role != "cmr":
        raise GuardError(f"unsupported role: {role}")
    if not isinstance(draft, dict):
        raise GuardError("draft must be a JSON object")
    validate_cmr_outcome(draft)
    if "evidencePaths" in draft:
        validate_evidence_paths(draft, evidence_root)
    # #745 Close Guard: a success/completed claim that still carries unchecked
    # checklist items is a false-completion signal → reject on the same path as
    # schema failures (exit 1; worker rewrites). No new states / runner / config.
    reject_success_with_open_checkboxes(draft)


# Open markdown checklist item: unordered bullets or ordered list markers. Keep
# the match on one physical line: \s also matches newlines in Python.
# Closed forms "- [x]" / "- [~] deferred: …" are not open work.
OPEN_CHECKBOX_RE = re.compile(r"(?m)^[ \t]*(?:[-*+][ \t]+|\d+[.)][ \t]+)\[ \](?:[ \t].*)?$")

# These fields describe a finding or its governance metadata; Markdown-looking
# text there is quoted/structured context, not draft work for the close guard.
NON_DRAFT_TEXT_KEYS = frozenset(
    {
        "claim_quote",
        "location",
        "category",
        "severity",
        "action",
        "identityKey",
        "status",
        "source",
        "scope",
        "kind",
        "evidencePaths",
        "successfulLegs",
        "skippedLegs",
        "claimedFixedFindingIdentityKeys",
        "disposition_reason",
        "reason",
        "boundedReopen",
        "findingIdentity",
    }
)

# Draft shapes that claim terminal success / completed work. CMR uses
# converged:true; keep status/kind literals so future role schemas get the same
# false-completion fence without a config surface.
SUCCESS_STATUS_VALUES = frozenset(
    {"success", "completed", "pushed", "pr_opened", "shipped"}
)
SUCCESS_KIND_VALUES = frozenset({"success", "completed", "shipped"})


def draft_claims_success(draft: dict) -> bool:
    if draft.get("converged") is True:
        return True
    status = draft.get("status")
    if isinstance(status, str) and status.strip().lower() in SUCCESS_STATUS_VALUES:
        return True
    kind = draft.get("kind")
    if isinstance(kind, str) and kind.strip().lower() in SUCCESS_KIND_VALUES:
        return True
    return False


def collect_strings(value: object, key: str = "") -> Iterator[str]:
    if key in NON_DRAFT_TEXT_KEYS:
        return
    if isinstance(value, str):
        yield value
    elif isinstance(value, list):
        for item in value:
            yield from collect_strings(item, key)
    elif isinstance(value, dict):
        for child_key, item in value.items():
            yield from collect_strings(item, child_key)


def find_open_checkboxes(draft: dict) -> list:
    open_items = []
    for text in collect_strings(draft):
        for match in OPEN_CHECKBOX_RE.finditer(text):
            open_items.append(match.group(0).strip())
    return open_items


def reject_success_with_open_checkboxes(draft: dict) -> None:
    if not draft_claims_success(draft):
        return
    open_items = find_open_checkboxes(draft)
    if not open_items:
        return
    preview = "; ".join(item[:120] for item in open_items[:5])
    more = f" (+{len(open_items) - 5} more)" if len(open_items) > 5 else ""
    raise GuardError(
        "success draft still contains unchecked checklist item(s): "
        f"{preview}{more}"
    )


def validate_cmr_outcome(draft: dict) -> None:
    if "escalate" in draft:
        validate_exact_fields(draft, {"escalate"}, "cmr")
        validate_escalation(draft["escalate"])
        return
    converged = draft.get("converged")
    base_fields = {
        "converged",
        "successfulLegs",
        "skippedLegs",
        "claimedFixedFindingIdentityKeys",
        "priorFindingDispositions",
        "findings",
        "evidencePaths",
    }
    if converged is True:
        allowed_fields = base_fields
    elif converged is False:
        allowed_fields = base_fields | {"reason"}
    else:
        raise GuardError("cmr verdict must set converged to a boolean")
    for field in draft:
        if field not in allowed_fields:
            raise GuardError(f"unexpected field: {field}")
    if converged is False:
        require_non_empty_string(draft, "reason")
    require_string_array(draft, "successfulLegs", min_len=1)
    if "skippedLegs" in draft:
        validate_skipped_legs(draft["skippedLegs"])
    require_string_array(draft, "claimedFixedFindingIdentityKeys")
    validate_prior_finding_dispositions(require_array(draft, "priorFindingDispositions"))
    if "findings" in draft:
        validate_findings(draft["findings"])
        if converged is True:
            reject_fix_now_findings_when_converged(draft["findings"])
    require_string_array(draft, "evidencePaths", min_len=1)


def validate_escalation(value: dict) -> None:
    if not isinstance(value, dict):
        raise GuardError("escalate must be an object")
    validate_exact_fields(value, {"reason", "diagnosis"}, "escalate")
    for field in ["reason", "diagnosis"]:
        if not isinstance(value[field], str) or value[field].strip() == "":
            raise GuardError(f"escalate.{field} must be a non-empty string")


def validate_evidence_paths(draft: dict, evidence_root: str) -> None:
    root = os.path.realpath(evidence_root)
    for idx, path in enumerate(draft["evidencePaths"]):
        if os.path.isabs(path):
            raise GuardError(f"evidencePaths[{idx}] must be relative: {path}")
        evidence_path = os.path.realpath(os.path.join(root, path))
        if os.path.commonpath([root, evidence_path]) != root:
            raise GuardError(f"evidencePaths[{idx}] escapes evidence root: {path}")
        if not os.path.exists(evidence_path):
            raise GuardError(f"evidencePaths[{idx}] does not exist: {path}")


def require_array(draft: dict, field: str) -> list:
    value = draft.get(field)
    if not isinstance(value, list):
        raise GuardError(f"{field} must be an array")
    return value


def require_non_empty_string(draft: dict, field: str) -> None:
    value = draft.get(field)
    if not isinstance(value, str) or value.strip() == "":
        raise GuardError(f"{field} must be a non-empty string")


def require_string_array(draft: dict, field: str, min_len: int = 0) -> None:
    values = require_array(draft, field)
    if len(values) < min_len:
        raise GuardError(f"{field} must contain at least {min_len} item(s)")
    for idx, value in enumerate(values):
        if not isinstance(value, str) or value.strip() == "":
            raise GuardError(f"{field}[{idx}] must be a non-empty string")


def validate_skipped_legs(value: list) -> None:
    if not isinstance(value, list):
        raise GuardError("skippedLegs must be an array")
    for idx, leg in enumerate(value):
        if not isinstance(leg, dict):
            raise GuardError(f"skippedLegs[{idx}] must be an object")
        validate_exact_fields(leg, {"slug", "reason"}, f"skippedLegs[{idx}]")
        for field in ["slug", "reason"]:
            if not isinstance(leg[field], str) or leg[field].strip() == "":
                raise GuardError(f"skippedLegs[{idx}].{field} must be a non-empty string")


def validate_findings(value: list) -> None:
    if not isinstance(value, list):
        raise GuardError("findings must be an array")
    required = {
        "severity",
        "category",
        "claim_quote",
        "location",
        "suggested_fix",
        "action",
    }
    allowed = required | {"disposition_reason", "disposition"}
    for idx, finding in enumerate(value):
        if not isinstance(finding, dict):
            raise GuardError(f"findings[{idx}] must be an object")
        validate_exact_fields(finding, allowed, f"findings[{idx}]", required)
        if finding["severity"] not in ["critical", "high", "medium", "low", "clarity"]:
            raise GuardError(f"findings[{idx}].severity is not a supported value")
        if finding["action"] not in ["fix_now", "wont_fix", "rejected"]:
            raise GuardError(f"findings[{idx}].action is not a supported value")
        for field in required - {"severity", "action"}:
            if not isinstance(finding[field], str) or finding[field].strip() == "":
                raise GuardError(f"findings[{idx}].{field} must be a non-empty string")
        if "disposition_reason" in finding and not isinstance(finding["disposition_reason"], str):
            raise GuardError(f"findings[{idx}].disposition_reason must be a string")
        if "disposition" in finding:
            validate_disposition_evidence(
                finding["disposition"],
                f"findings[{idx}].disposition",
            )
        disposition = finding.get("disposition")
        disposition_kind = disposition.get("kind") if isinstance(disposition, dict) else None
        if finding["severity"] in ["critical", "high"] and finding["action"] != "fix_now":
            raise GuardError(f"findings[{idx}].action must be fix_now for critical/high severity")
        # #604 correctness r1 (P2-a): accepted_suppressed is only valid on
        # wont_fix/rejected — never on fix_now (it would silently become a blocker).
        if finding["action"] not in ["wont_fix", "rejected"] and disposition_kind == "accepted_suppressed":
            raise GuardError(f"findings[{idx}].disposition accepted_suppressed is only valid on wont_fix/rejected")
        if finding["action"] in ["wont_fix", "rejected"]:
            if disposition is None:
                raise GuardError(f"findings[{idx}].disposition is required for wont_fix/rejected")
            if disposition_kind != "accepted_suppressed":
                raise GuardError(f"findings[{idx}].disposition must be accepted_suppressed for wont_fix/rejected")


def reject_fix_now_findings_when_converged(value: list) -> None:
    for idx, finding in enumerate(value):
        if isinstance(finding, dict) and finding.get("action") == "fix_now":
            raise GuardError(f"findings[{idx}].action cannot be fix_now when converged is true")


def validate_disposition_evidence(value: dict, label: str) -> None:
    if not isinstance(value, dict):
        raise GuardError(f"{label} must be an object")
    kind = value.get("kind")
    # #604 correctness r1 (P2-b) / ADR 0062: the routing disposition kinds
    # (same_module / cross_module / spec_conflict / infra_failure /
    # owning_issue_still_red) were deleted from the reviewer contract. The Python
    # outcome-guard (slice-4 missed it) now accepts ONLY the accepted_suppressed
    # governance carrier —口径 parity with the TS validate/isValidFinding path.
    if not isinstance(kind, str) or kind not in [
        "accepted_suppressed",
    ]:
        raise GuardError(f"{label}.kind is not a supported value")

    if kind == "accepted_suppressed":
        required = {"kind", "source", "scope", "reason", "boundedReopen"}
        # #604 correctness r2 (C3): `targetModule` was deleted from the TS reviewer
        # contract (findingDispositionSchema / cmrDispositionEvidenceSchema
        # `.strict()`), so the family parser rejects it. Drop it from the guard's
        # allowed set too so the guard and the family parser agree (口径 parity /
        # invariant #3 cross-entry consistency) — no入口 silently swallows a
        # deleted field.
        allowed = required | {"findingIdentity"}
    validate_exact_fields(value, allowed, label, required)
    for field in required - {"kind"}:
        if not isinstance(value[field], str) or value[field].strip() == "":
            raise GuardError(f"{label}.{field} must be a non-empty string")
    for field in allowed - required:
        if field in value and (not isinstance(value[field], str) or value[field].strip() == ""):
            raise GuardError(f"{label}.{field} must be a non-empty string")
    if kind == "accepted_suppressed":
        if not has_explicit_accepted_suppression_source(value["source"]):
            raise GuardError(f"{label}.source must name an explicit user/ADR/issue source")
        if not has_bounded_reopen_condition(value["boundedReopen"]):
            raise GuardError(f"{label}.boundedReopen must include a bounded reopen condition")


def has_explicit_accepted_suppression_source(value: str) -> bool:
    return re.search(
        r"(^|\s)(#\d+|issue\s*#?\s*\d+|adr[-\s]*0*\d+|owner|human|user)\b",
        value,
        re.I,
    ) is not None


def has_bounded_reopen_condition(value: str) -> bool:
    return re.search(r"\breopen\b", value, re.I) is not None and re.search(
        r"\b(if|when|on|upon|unless)\b",
        value,
        re.I,
    ) is not None


def validate_prior_finding_dispositions(value: list) -> None:
    allowed = {"identityKey", "status", "reason", "source", "scope", "boundedReopen"}
    required = {"identityKey", "status"}
    statuses = [
        "still-active",
        "verified-closed",
        "unable-to-assess",
        "accepted_suppressed",
    ]
    for idx, disposition in enumerate(value):
        label = f"priorFindingDispositions[{idx}]"
        if not isinstance(disposition, dict):
            raise GuardError(f"{label} must be an object")
        validate_exact_fields(disposition, allowed, label, required)
        for field in required:
            if not isinstance(disposition[field], str) or disposition[field].strip() == "":
                raise GuardError(f"{label}.{field} must be a non-empty string")
        if disposition["status"] not in statuses:
            raise GuardError(f"{label}.status is not a supported value")
        for field in allowed - required:
            if field in disposition and not isinstance(disposition[field], str):
                raise GuardError(f"{label}.{field} must be a string")
        if disposition["status"] == "accepted_suppressed":
            for field in ["reason", "source", "scope", "boundedReopen"]:
                if field not in disposition or disposition[field].strip() == "":
                    raise GuardError(f"{label}.{field} is required for accepted_suppressed")
            if not has_explicit_accepted_suppression_source(disposition["source"]):
                raise GuardError(f"{label}.source must name an explicit user/ADR/issue source")
            if not has_bounded_reopen_condition(disposition["boundedReopen"]):
                raise GuardError(f"{label}.boundedReopen must include a bounded reopen condition")


def validate_exact_fields(
    obj: dict,
    allowed: set,
    label: str,
    required=None,
) -> None:
    required = allowed if required is None else required
    for field in obj:
        if field not in allowed:
            raise GuardError(f"unexpected field: {label}.{field}")
    for field in required:
        if field not in obj:
            raise GuardError(f"{label}.{field} is required")


if __name__ == "__main__":
    raise SystemExit(main())
