# Ming orchestrator worker image — 2b full pack (#333, ADR 0026 / ADR 0016 bake).
#
# 2a (#332) baked the minimal /tdd closure + coder soul so the coder worker runs.
# 2b (#333) EXTENDS 2a to the FULL coherent dev-skill pack +
# the multi-model review CLIs (codex already in base, + agy/Gemini installed here),
# so the cmr / ship / review / fix / merger workers can each invoke their skill
# from the IMAGE (the bake gap ADR 0026 / #330 calls out).
# Souls live via mount (unconditional-rebuild #372); only skills + CLIs + hooks baked.
#
# NOTE: the runner must NOT bind-mount host skills over
# /home/agent/.claude/skills. The baked image is the skill truth source; a
# runtime skill mount would shadow it and reintroduce host-state drift. Souls
# (and similar data) are mounted live from host (see #372 unconditional rebuild)
# so edits take effect immediately without requiring image rebuild for them.
# Runtime mounts limited to worktree + live auth + souls.
#
# FROM the existing sc-pipeline base (claude + codex CLIs + node + python + bash +
# git + curl + jq already baked); this layer ADDS:
#   - the full dev-skill closure (see SKILL CLOSURE GRAPH below)
#   - agy (Gemini CLI, Linux build) + grok (SuperGrok CLI, Linux; #807)
#     + gh + bun (gstack-ship + cmr deps)
# Souls (coder/reviewer/... .md) are mounted live at runtime (#372), not baked.
#
# Build context is a STAGING dir prepared by build.sh, NOT this directory: build.sh
# `cp -RL`-resolves the host skill symlinks into staging/skills/, bakes the gstack
# closure subtree, and copies the repo-root CLAUDE.md (which carries the
# machine-executable `## Skill routing` section). Souls are NOT copied (mounted
# live at runtime per #372 unconditional rebuild). Run via `image/build.sh`,
# never `docker build image/` directly.
#
# ── SKILL CLOSURE GRAPH (what is baked + why; closed under internal invocation) ─
#   tdd                            → codebase-design          (refactor step)
#   codebase-design                → (leaf)
#   diagnosing-bugs                → improve-codebase-architecture
#   improve-codebase-architecture  → codebase-design
#   resolving-merge-conflicts      → (leaf)                   (merger worker)
#   ak-cross-m-review              → diagnosing-bugs          (cmr non-trivial fix)
#                                    + codex CLI + agy CLI + Claude `Agent`/`Task`
#   ak-cmr-completeness            → ak-cross-m-review        (ship-pre Step 5 lens entry)
#   ak-cmr-correctness             → ak-cross-m-review        (ship-pre Step 6 lens entry)
#   gstack-ship                    → ~/.claude/skills/gstack/{bin,scripts,ship,
#                                       review,...} helper closure (baked subtree)
#   gstack-document-release        → top-level invoke for S12 (#735); nested
#                                    gstack/document-release remains for ship Step 18
#   `review`                       = BUILTIN Claude Code command, NOT a disk skill
#                                    → nothing to bake; route stays active.
# The 2a chain `diagnosing-bugs → improve-codebase-architecture` was DANGLING in
# 2a (improve not baked); 2b closes it. Every internally-invoked skill is present.
#
# Reproducibility: pin the base by digest in CI; locally we ride sc-pipeline:latest.
# Skill content manifest (skills-manifest.sha256) is emitted by build.sh for
# audit only (no fail-closed EXPECTED_SKILLS_SHA gate; the gate was removed in
# #372 unconditional rebuild — manifest is emit-only).
ARG BASE_IMAGE=sc-pipeline:latest
FROM ${BASE_IMAGE}

USER root

# ── Multi-model review CLIs + gstack-ship runtime deps ───────────────────────
# claude + codex are already in the base (#332 verified). 2b adds:
#   - gh   : gstack-ship PR creation + cmr native-dependency reads
#   - bun  : a few gstack helper bin scripts have a `#!/usr/bin/env bun` shebang
#            (gstack-next-version / gstack-version-bump / gstack-redact); without
#            bun those degrade to the skill's prose fallback, but baking bun keeps
#            gstack-ship fully functional.
#   - agy  : the Gemini review leg (cmr 三腿). Linux build — the macOS host binary
#            is NOT portable (it is a macOS ELF), so we install the Linux ELF via
#            the official installer (issue #333 spike: aarch64 Linux agy installs
#            + runs in-container).
#   - grok : SuperGrok / grok-build pool CLI (#807). Same portability rule as agy —
#            host `~/.grok/bin/grok` is a macOS Mach-O and must NOT be copied in;
#            bake the Linux ELF via the official installer (https://x.ai/cli/install.sh).
#            Installer drops under `$HOME/.grok/bin/` (default) and may symlink into
#            `~/.local/bin`; we always expose `/usr/local/bin/grok` for PATH.
# agy AUTH is NOT baked: it is live OAuth material. The cmr sandbox copies the
# host token into a per-run writable dir and mounts it at
#   /home/agent/.gemini/antigravity-cli/
# so the in-container agy leg can read
# `antigravity-oauth-token` and refresh/write runtime state without touching the
# host file directly. When the token is absent, that leg degrades; the rest of the
# cmr still runs.
# grok AUTH is NOT baked either: live OAuth in host `~/.grok/auth.json`. The
# orchestrator copies it into a per-issue writable dir and bind-mounts at
#   /home/agent/.grok/
# (realBackend.ts `mountAuth`, #807). Missing host auth → that leg degrades.
# codex AUTH = writable CODEX_HOME: the orchestrator copies ~/.codex into a
# per-issue writable dir and bind-mounts it to /home/agent/.codex — NOT a ro
# mount, or codex's first run rc=1 on an unwritable auth dir (spike constraint #2;
# already implemented in realBackend.ts `mountAuth`). claude AUTH =
# CLAUDE_CODE_OAUTH_TOKEN env (already wired).
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends gh ca-certificates; \
    rm -rf /var/lib/apt/lists/*

# bun (system-wide) — used by a handful of gstack-ship helper scripts.
RUN set -eux; \
    curl -fsSL https://bun.sh/install | BUN_INSTALL=/usr/local bash; \
    ln -sf /usr/local/bin/bun /usr/local/bin/bunx 2>/dev/null || true; \
    /usr/local/bin/bun --version

# agy (Gemini CLI, Linux). The installer drops the binary under the INVOKING
# user's ~/.local/bin, so run it as `agent` and expose it on PATH for all users.
USER agent
RUN set -eux; \
    curl -fsSL https://antigravity.google/cli/install.sh | bash; \
    test -x "$HOME/.local/bin/agy"
USER root
RUN set -eux; \
    ln -sf /home/agent/.local/bin/agy /usr/local/bin/agy; \
    agy --version 2>/dev/null || true   # version probe may need auth; presence is the gate

# grok (SuperGrok CLI, Linux; #807). Installer writes under the invoking user's
# ~/.grok/{bin,downloads}/ — run as `agent`, then symlink onto PATH for all users.
# Official npm package is pinned exactly; npm verifies its registry integrity
# metadata and the version check below fails the build on drift.
USER agent
RUN set -eux; \
    npm install -g @xai-official/grok@0.2.93; \
    test -x "$HOME/.npm-global/bin/grok" || command -v grok
USER root
RUN set -eux; \
    # Real copy (not symlink into ~/.grok/bin): runtime mounts a per-issue
    # auth dir over /home/agent/.grok (codex-style), which would break a
    # PATH symlink whose target lives under that tree (#807 mountAuth).
    cp -L "$(su - agent -c 'command -v grok')" /usr/local/bin/grok; \
    chmod 755 /usr/local/bin/grok; \
    # Placeholder so a file bind-mount of auth.json is never mistaken for a dir.
    # (agent's primary group is not named "agent" on this base image — chown
    # by user only.)
    mkdir -p /home/agent/.grok; \
    touch /home/agent/.grok/auth.json; \
    chown agent /home/agent/.grok /home/agent/.grok/auth.json; \
    chmod 600 /home/agent/.grok/auth.json; \
    grok --version | grep -F "0.2.93"
# ── codex sandbox / userns note (spike constraint #3) ────────────────────────
# codex ships its own bwrap sandbox. In a NON-privileged container bwrap cannot
# create a user namespace ("No permissions to create a new namespace ... the
# kernel does not allow non-privileged user namespaces") → codex falls back to
# hunk-local grounding (can't grep the whole repo). To give codex FULL repo
# grounding the RUNTIME must either run the container with userns enabled
# (`--security-opt seccomp=unconfined` + host `kernel.unprivileged_userns_clone=1`,
# or `--privileged`) OR disable codex's own sandbox. This is a RUNTIME launch
# concern (orchestrator `docker(...)` opts, #335/#336), not a build-time bake —
# documented here so the runner slice wires it. cmr still catches in-hunk bugs
# without it (spike: codex rc=0 + caught the injected bug on hunk grounding).

# ── Bake the full dev-skill closure into the agent's skills dir ──────────────
# build.sh staged staging/skills/ with the closure graph above (incl. the
# gstack/ closure subtree at the path gstack-ship hardcodes).
COPY skills/ /home/agent/.claude/skills/
# Bake the content manifest of exactly what was baked, so a built image is
# auditable (skill source is mutable host state — build.sh writes the sha256).
COPY skills-manifest.txt skills-manifest.sha256 /home/agent/.orchestrator/

# ── Bake the workspace skill-routing CLAUDE.md as a fallback reference ────────
# The live worktree CLAUDE.md (mounted at runtime) is what the agent reads in
# normal operation; baking a copy here documents the routing the image was built
# against and lets a bare `docker run` demo route without a mounted worktree.
# (Souls are mounted live at /home/agent/.orchestrator/souls per #372; not baked.)
COPY CLAUDE.routing.md /home/agent/.orchestrator/CLAUDE.routing.md

# ── Bake the commit-msg git hook ─────────────────────────────────────────────
# Tags every in-container commit's subject with the `sandcastle:` prefix
# (orchestrator/CLAUDE.md). Wired via `git config --global core.hooksPath` below
# (after USER agent, so it lands in the agent's ~/.gitconfig). Image-only by
# construction → never fires on host commits; deterministic → catches commits a
# soul instruction misses (gstack-ship's own version-bump / review-fix commits).
COPY hooks/ /home/agent/.orchestrator/githooks/

# ── Bake worker outcome guard ────────────────────────────────────────────────
# Generic pre-completion worker outcome guard. Workers hand it a draft; it writes
# the sidecar and compatibility tag/signal only after schema + evidence checks.
COPY bin/ /home/agent/.orchestrator/bin/

RUN chmod -R a+rX /home/agent/.claude/skills /home/agent/.orchestrator \
 && chmod +x /home/agent/.orchestrator/githooks/commit-msg \
 && chmod +x /home/agent/.orchestrator/bin/orchestrator-outcome-guard \
 && ln -sf /home/agent/.orchestrator/bin/orchestrator-outcome-guard /usr/local/bin/orchestrator-outcome-guard \
 && find /home/agent/.claude/skills -type f -name '*.sh' -exec chmod +x {} + 2>/dev/null \
 ; find /home/agent/.claude/skills/gstack/bin -type f -exec chmod +x {} + 2>/dev/null \
 ; (id agent >/dev/null 2>&1 \
      && chown -R agent /home/agent/.claude /home/agent/.orchestrator /home/agent/.local || true)

USER agent

# core.hooksPath (global, as the agent user) activates the baked commit-msg hook
# for EVERY repo the in-container agent commits in — all worktrees, all workers.
RUN git config --global core.hooksPath /home/agent/.orchestrator/githooks
