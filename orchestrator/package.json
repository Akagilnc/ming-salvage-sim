{
  "name": "@ming/orchestrator",
  "version": "0.35.1.0",
  "private": true,
  "description": "Ming LLM Epic Orchestrator — runner for AFK TDD dev loop (#244)",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/apply-sandcastle-cancel-patch.mjs",
    "test": "tsc -p tsconfig.test.json --noEmit && vitest run",
    "test:fast": "tsc -p tsconfig.test.json --noEmit && NODE_OPTIONS=\"--require=./test/fast-tax-preload.cjs${NODE_OPTIONS:+ $NODE_OPTIONS}\" vitest run --config vitest.fast.config.ts",
    "test:fast:guard": "NODE_OPTIONS=\"--require=./test/fast-tax-preload.cjs${NODE_OPTIONS:+ $NODE_OPTIONS}\" vitest run --config vitest.fast-guard.config.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "status": "node --experimental-strip-types src/familyStatusCli.ts",
    "rebake": "bash image/build.sh",
    "rebake:no-cache": "bash image/build.sh --no-cache"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@ai-hero/sandcastle": "0.12.0",
    "mdast-util-to-string": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "zod": "^4.4.3"
  }
}
