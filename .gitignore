# Orchestrator (#256) clean-room issue snapshot — host-fetched read-only context
# written into the resident slice worktree; must never be committed into the
# reviewed/pushed branch (a coder's `git add -A` would otherwise stage it). The
# Backend also adds it to the per-worktree .git/info/exclude as a suspenders belt.
.orchestrator-snapshot.json
# Orchestrator (integ-cmr 256 r3) fix-loop findings — host-written read-only
# context handed to the S5 coder_fix step; same clean-room rule as the snapshot.
.orchestrator-fix-findings.json
